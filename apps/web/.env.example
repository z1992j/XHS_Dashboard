# 订单模块（Supabase）—— 不设则用 src/orders/config.ts 里的默认值
# 这里放的全是「发布用」公开值（anon/publishable key、页面密码哈希），不是机密。
# service_role key 和数据库密码永远不要写进前端环境。

# Supabase 项目地址与匿名 key（换项目时改这两条）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# 页面密码闸门。明文密码不进仓库，只进哈希：
#   node tools/hash-password.js '新密码'
# 它会输出可直接粘贴进 config.ts 的一行（或填到这里覆盖默认值）。
VITE_ORDER_PASSWORD_SALT=sales-order-auth-v1
VITE_ORDER_PASSWORD_HASH=

# Supabase 侧共享登录账号（GoTrue），密码与页面密码同一个明文
VITE_ORDER_AUTH_EMAIL=team@sales-order.local

# 录入订单的归属人（「我的 / 其他归属」视图按它切分）
VITE_ORDER_SALES_PERSON=大卫
