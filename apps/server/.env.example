# ====== 服务 ======
PORT=3000

# ====== API 鉴权 ======
# 留空 = 开放访问（当前线上行为）。
# 填值后 /api/xhs/* 需要 Bearer 令牌，前端会自动弹窗要求输入，无需重新部署前端。
API_TOKEN=

# ====== MySQL ======
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=broadband
DB_POOL_SIZE=10

# ====== AI 服务 ======
# 可选: deepseek / dashscope / openai
XHS_AI_PROVIDER=deepseek
XHS_AI_KEY=
# deepseek-chat 是 DeepSeek 的稳定别名，官方会把它指向当前的主力模型。
# 2026-09-10 发布 V4.1 Flash 时，官方公告把原 V4 Pro 的请求整体路由到
# V4.1 Flash 并按新价计费 —— 也就是说这里不用改任何东西就会自动吃到升级。
# 不要填 deepseek-v4.1-flash-expires-on-0910 这类内测 ID：名字里就写着
# 哪天过期，到期后所有请求会直接失败。要锁定某个具体型号再改这一行。
XHS_AI_MODEL=deepseek-chat

# ====== 视觉模型（看图成文）======
# 默认已启用：只要上面配了 XHS_AI_KEY 就能用，这三个变量全部可以不填。
# 模型名不是密钥，默认值写在代码里，视觉模型自动跟随文案模型所在平台。
# deepseek 这条是一串候选链，按顺序试，前一个报"模型不存在"就自动换下一个：
#   deepseek  -> deepseek-v4-flash-vision-exp → deepseek-chat
#                （前者是 V4.1 Flash 之前的实验分支，正式版发布后随时会下线；
#                  后者原生多模态，是下线之后的兜底）
#   dashscope -> qwen-vl-max
#   openai    -> gpt-4o
# 只在需要覆盖时才填：
#   XHS_VISION_MODEL=off        关闭该功能
#   XHS_VISION_MODEL=<型号>     指定别的型号（填了就只用这一个，不再自动降级）
#   XHS_VISION_PROVIDER/KEY     换到另一个平台（两个要一起填）
XHS_VISION_PROVIDER=
XHS_VISION_KEY=
XHS_VISION_MODEL=

# ====== 上传文件回收 ======
# 提取链接时会下载配图；用户不保存的话这些文件会滞留。
# XHS_UPLOAD_SWEEP=1 才会每天自动清理；默认关闭，先用
# GET /api/xhs/uploads-orphans 干跑看看会删哪些。
# TTL 要留足：前端草稿会在 localStorage 里引用 uploads 路径。
XHS_UPLOAD_SWEEP=0
XHS_UPLOAD_TTL_DAYS=7

# ====== 图片上传目录 ======
XHS_UPLOAD_DIR=/var/www/xhs-writer/uploads
